# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

.playwright-test/
.playwright-mcp
.playwright-screenshots/*
*.screenshot.png
!.playwright-screenshots/.gitkeep


# typescript
*.tsbuildinfo
next-env.d.ts

# JSON database (local data storage)
/data/database.json

# User uploaded files (keep directory structure but ignore uploaded files)
/public/uploads/avatars/*
!/public/uploads/avatars/.gitkeep

# AI workspace (temporary iteration documents)
/.ai-workspace/*
!/.ai-workspace/README.md

/.github
.env*.local

# Image Generation Assets
data/flux-dataset.json
# public/products/ <-- Kept for website hosting
data/catalog-review.json
data/*-backup-*.json
scripts/image-generation/templates/__tests__/
