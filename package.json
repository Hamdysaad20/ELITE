{
  "name": "elite-coffee-shop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:turbo": "next dev -H 0.0.0.0 --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "npx tsc --noEmit && next lint",
    "format": "npx biome format --write",
    "db:reset": "echo {\"carts\":{},\"orders\":[]} > data/database.json && echo Database reset complete!",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "worker:odoo": "TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register ./scripts/run-odoo-worker.ts",
    "loyalty:seed": "TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register ./scripts/seed-elite-rewards.ts",
    "loyalty:migrate": "TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register ./scripts/migrate-loyalty-data.ts",
    "loyalty:tier-check": "TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register ./scripts/monthly-tier-check.ts",
    "loyalty:weekly-reset": "TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register ./scripts/weekly-challenge-reset.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^8.38.0",
    "axios": "^1.13.1",
    "axios-cookiejar-support": "^6.0.4",
    "bullmq": "^5.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.6",
    "gsap": "^3.13.0",
    "jose": "^5.9.3",
    "lucide-react": "^0.525.0",
    "next": "^15.5.7",
    "next-auth": "^4.24.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^4.6.14",
    "same-runtime": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tough-cookie": "^5.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20.17.50",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.27.0",
    "eslint-config-next": "15.1.7",
    "nodemailer": "^7.0.7",
    "postcss": "^8.5.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
