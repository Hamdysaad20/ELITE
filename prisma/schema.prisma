generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  image         String?
  role          String          @default("user")
  status        String          @default("active")
  lastLoginAt   DateTime?
  loyalty       LoyaltyAccount?
  orders        Order[]
  ledger        LoyaltyLedger[] @relation("UserLedger")
  accounts      Account[]
  sessions      Session[]
  reviews       Review[]        @relation("UserReviews")
  addresses     Address[]       @relation("UserAddresses")
  
  // New relations for analytics
  userSavings        UserSavings?
  userPoints         UserPoints?
  orderPoints        OrderPoints[]
  pointsTransactions PointsTransaction[]
  
  // Gamification relations
  achievements   UserAchievement[]
  streaks       UserStreak[]
  badges         UserBadge[]
  rewardEvents   RewardEvent[]
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([email])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([token])
}

model LoyaltyAccount {
  user       User     @relation(fields: [userId], references: [id])
  userId     String   @id
  points     Int      @default(0)
  totalSpent Decimal  @default(0)
  level      String   @default("bronze")
  updatedAt  DateTime @updatedAt
}

model LoyaltyLedger {
  id          String   @id @default(uuid())
  user        User     @relation("UserLedger", fields: [userId], references: [id])
  userId      String
  order       Order?   @relation("OrderLedger", fields: [orderId], references: [id])
  orderId     String?
  deltaPoints Int
  reason      String?
  createdAt   DateTime @default(now())
}

model Order {
  id             String          @id @default(uuid())
  user           User?           @relation(fields: [userId], references: [id])
  userId         String?
  address        Address?        @relation(fields: [addressId], references: [id])
  addressId      String?
  status         String
  paymentStatus  String
  paymentMethod  String
  orderType      String
  subtotal       Decimal
  deliveryFee    Decimal
  codFee         Decimal         @default(0)
  discount       Decimal
  total          Decimal
  notes          String?
  saleOrderId    Int?
  posOrderId     Int?
  odooWebUrl     String?
  odooStatusSale String          @default("pending")
  odooStatusPos  String          @default("pending")
  clientOrderRef String          @unique
  
  // Retry tracking for Odoo sync (30-min max window)
  odooSyncAttempts      Int       @default(0)
  odooSyncLastError     String?
  odooSyncLastAttemptAt DateTime?
  odooSyncNotifiedAt    DateTime?  // When customer was notified of sync failure
  
  // New fields for analytics
  originalPrice   Decimal?        // Price before discounts
  discountApplied Boolean         @default(false)
  pointsEarned    Int             @default(0)
  
  items          OrderItem[]
  ledger         LoyaltyLedger[] @relation("OrderLedger")
  savings        OrderSavings?
  points         OrderPoints?
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model CheckoutConfig {
  id                    String   @id @default("checkout")
  enabledPaymentMethods Json
  deliveryFee           Decimal  @default(15)
  codFee                Decimal  @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model OrderItem {
  id         String  @id @default(uuid())
  order      Order   @relation(fields: [orderId], references: [id])
  orderId    String
  productId  String
  sku        String?
  name       String
  categoryId String?
  quantity   Int
  unitPrice  Decimal
  totalPrice Decimal
  attributes Json?
}

model ProductsSnapshot {
  id       String   @id
  data     Json
  syncedAt DateTime @default(now())
}

model SyncRun {
  id         String    @id @default(uuid())
  kind       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  status     String    @default("pending")
  itemCount  Int?
  error      String?
}

model Review {
  id          String   @id @default(uuid())
  user        User     @relation("UserReviews", fields: [userId], references: [id])
  userId      String
  productId   String
  productName String
  rating      Int // 1-5 stars
  comment     String?
  helpful     Int      @default(0)
  verified    Boolean  @default(false)
  status      String   @default("pending") // pending, approved, rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, productId]) // One review per product per user
  @@index([productId])
  @@index([userId])
  @@index([status])
}

model Address {
  id        String   @id @default(uuid())
  user      User     @relation("UserAddresses", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  label     String   // e.g., "Home", "Work", "Office"
  street    String
  apartment String?
  city      String
  state     String?
  zipCode   String?
  country   String   @default("Egypt")
  phone     String?
  notes     String?  // Delivery instructions
  isDefault Boolean  @default(false)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

// Analytics Models

model OrderSavings {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  originalPrice Decimal  // Price before discounts
  finalPrice    Decimal  // Price after discounts
  totalSavings  Decimal  // Calculated savings
  
  discounts     Json     // Array of discount objects
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([orderId])
  @@index([createdAt])
}

model OrderPoints {
  id              String    @id @default(uuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  basePoints      Int       // Points from order value (total * 100)
  bonusPoints     Int       @default(0)
  multiplier      Decimal   @default(1.0)
  totalPoints     Int       // Calculated total
  
  pointsBreakdown Json      // Detailed breakdown
  
  earnedAt        DateTime  @default(now())
  expiresAt       DateTime? // Point expiration (1 year)
  isExpired       Boolean   @default(false)
  
  @@index([userId])
  @@index([orderId])
  @@index([earnedAt])
}

model UserSavings {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  totalSaved              Decimal  @default(0)
  totalOrders             Int      @default(0)
  averageSavingsPerOrder  Decimal  @default(0)
  
  savingsByMonth          Json     // Monthly breakdown
  
  lastUpdated             DateTime @updatedAt
  
  @@index([userId])
}

model UserPoints {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  totalPoints   Int      @default(0)     // Current balance
  totalEarned   Int      @default(0)     // Lifetime earned
  totalRedeemed Int      @default(0)     // Lifetime spent
  
  tier          String   @default("bronze") // bronze, silver, gold, platinum
  nextTierAt    Int      @default(100000)   // 1,000 EGP in points
  
  lastUpdated   DateTime @updatedAt
  
  @@index([userId])
  @@index([tier])
}

model PointsTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      String   // 'earn' | 'redeem' | 'expire' | 'adjust'
  amount    Int      // Positive for earn, negative for redeem
  balance   Int      // Balance after transaction
  
  reason    String   // Description of transaction
  orderId   String?  // Related order if applicable
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
  @@index([type])
}


// New POS-related models

model Product {
  id                 String   @id
  name               String
  description        String?
  price              Decimal
  sku                String?
  barcode            String?
  isArchived         Boolean  @default(false)
  isFeatured         Boolean  @default(false)
  
  // Odoo-specific fields
  odooId             Int      @unique
  sequence           Int?
  
  // POS display fields
  posAvailable       Boolean  @default(true)
  posShortName       String?
  
  // Categorization
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id])
  
  // Inventory
  stockQuantity      Int      @default(0)
  
  // Timestamps
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  // Relations
  variants           ProductVariant[]
  attributeValues    ProductAttributeValue[]
  posCategory        PosCategory? @relation(fields: [posCategoryId], references: [id])
  posCategoryId      String?
  
  @@index([name])
  @@index([sku])
  @@index([isArchived])
  @@index([posAvailable])
  @@index([categoryId])
  @@index([posCategoryId])
}

model Category {
  id          String    @id
  name        String
  description String?
  
  // Odoo-specific fields
  odooId      Int       @unique
  
  // Hierarchy
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  
  // Relations
  products    Product[]
  dealCategories DealCategory[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([name])
  @@index([parentId])
}

model Attribute {
  id          String    @id
  name        String    @unique
  description String?
  
  // Odoo-specific fields
  odooId      Int       @unique
  
  // Display settings
  displayType String    @default("radio") // e.g., 'radio', 'select', 'color'
  
  // Relations
  values      AttributeValue[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([name])
}

model AttributeValue {
  id          String    @id
  name        String
  
  // Odoo-specific fields
  odooId      Int       @unique
  
  // Relations
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  
  // For display
  htmlColor   String?
  
  // Pricing
  priceExtra  Decimal   @default(0)
  
  // Relations to Product
  productLinks ProductAttributeValue[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([name])
  @@index([attributeId])
}

model ProductAttributeValue {
  productId       String
  attributeValueId String
  
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue  AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  
  @@id([productId, attributeValueId])
  @@index([productId])
  @@index([attributeValueId])
}

model ProductVariant {
  id          String    @id
  name        String
  sku         String?
  barcode     String?
  price       Decimal
  
  // Odoo-specific fields
  odooId      Int       @unique
  
  // Relations
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Combination of attribute values that define this variant
  attributeCombination Json
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([sku])
  @@index([productId])
}

// POS-specific UI/UX models

model PosCategory {
  id          String    @id
  name        String    @unique
  sequence    Int       @default(0)
  
  // Relations
  products    Product[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([name])
  @@index([sequence])
}

model PosConfig {
  id              String   @id @default("pos")
  gridConfig      Json     // Defines the layout of the POS screen
  defaultCategory String?  // ID of the default category to show
  
  updatedAt       DateTime @updatedAt
}

// Gamification Models

model Achievement {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String
  category      String
  icon          String?
  tier          String   @default("bronze")
  
  requirementType String
  requirementValue Int
  requirementData Json?
  
  rewards       AchievementReward[]
  userProgress  UserAchievement[]
  
  isActive      Boolean  @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([code])
  @@index([category])
  @@index([isActive])
}

model AchievementReward {
  id            String   @id @default(uuid())
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  rewardType    String
  rewardValue   Json
  rewardName    String
  
  priority      Int      @default(0)
  isActive      Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([achievementId])
  @@index([rewardType])
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  progress      Int      @default(0)
  target        Int
  isCompleted   Boolean  @default(false)
  completedAt   DateTime?
  
  rewardsAwarded Json    @default("[]")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([isCompleted])
}

model UserStreak {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  streakType    String
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActivityAt DateTime?
  
  gracePeriodHours Int   @default(4)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([userId, streakType])
  @@index([userId])
  @@index([streakType])
}

model RewardEvent {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  triggerType   String
  triggerId     String?
  triggerData   Json?
  
  rewards       Json
  status        String   @default("pending")
  errorMessage  String?
  
  createdAt     DateTime @default(now())
  processedAt   DateTime?
  
  @@index([userId])
  @@index([triggerType])
  @@index([status])
  @@index([createdAt])
}

model Badge {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String
  icon          String
  category      String
  rarity        String   @default("common")
  
  unlockType    String
  unlockData    Json?
  
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  userBadges    UserBadge[]
  
  @@index([code])
  @@index([category])
  @@index([rarity])
}

model UserBadge {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId       String
  badge         Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  
  unlockedAt    DateTime @default(now())
  isDisplayed    Boolean  @default(true)
  
  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@index([unlockedAt])
}

// Deal Management Models (Category-based Architecture)

model Deal {
  id            String   @id @default(uuid())
  name          String
  description   String?
  slug          String   @unique
  
  // Odoo Integration
  odooPricelistId Int?    @unique // Links to Odoo pricelist
  odooPricelistName String? // For reference
  
  // Deal Configuration
  discountType  String   // 'percentage' | 'fixed'
  discountValue Decimal  // Percentage (0-100) or fixed amount
  maxDiscount   Decimal? // Maximum discount cap (e.g., 40%)
  
  // Time-based Validity
  startDate     DateTime?
  endDate       DateTime?
  timeWindow    Json?    // { days: [0,1,2], startTime: "08:00", endTime: "13:00" }
  
  // Status
  isActive      Boolean  @default(true)
  priority      Int      @default(0) // Higher priority deals override lower ones
  
  // Relations
  categories    DealCategory[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([slug])
  @@index([isActive])
  @@index([odooPricelistId])
  @@index([priority])
}

model DealCategory {
  id          String   @id @default(uuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  
  @@unique([dealId, categoryId])
  @@index([dealId])
  @@index([categoryId])
}
